# 环境变量示例文件
#
# 用法：首次使用时执行  cp .env.example .env  生成本地环境变量文件。
#       （工程 .gitignore 忽略了 .env / .env.*，仅放行 *.example，
#        因此克隆仓库后必须自行复制一份，否则 VUE_APP_SOCKET_URL 为空会让
#        src/layout/components/Navbar/index.vue 拼出 "undefined<随机串>" 的 WebSocket 地址。）
#
# 键名沿用源码（VUE_APP_BASE_API / VUE_APP_DELETE_PERMISSIONS / VUE_APP_SOCKET_URL），勿改名。
# 注意：BASE_URL 由 vue.config.js 的 publicPath 派生（''），不写进 .env。
#
# 以下为可直接使用的真实默认值（非占位符）。

# 接口基础地址，对应 src/utils/request.ts 的 axios baseURL
VUE_APP_BASE_API=/api

# 是否开启删除权限校验，对应 src/utils/common.ts 的 checkProcessEnv()
VUE_APP_DELETE_PERMISSIONS=false

# WebSocket 地址前缀，对应 src/layout/components/Navbar/index.vue
VUE_APP_SOCKET_URL=ws://localhost/ws/
