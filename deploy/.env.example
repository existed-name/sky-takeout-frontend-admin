# ============================================================================
# 部署用环境变量模板
#
# 本文件【只列键名，值一律留空，不含任何真实密钥】。
# 用法：
#   1) 复制一份：  cp .env.example .env
#   2) 按下面每行的注释，把值填进 .env（对照本机的后端配置文件 application-dev.yml 取值）。
#
# 关于 .env：
#   - .env 不入库（.gitignore 忽略 .env），只存在于本机与服务器本地；
#   - 服务器上请执行 chmod 600 .env，仅属主可读；
#   - 本文件与 docker-compose.yml 同目录，compose 会自动读取它：
#       既用于 compose 内部的 ${...} 变量插值，也通过 env_file 注入各个容器；
#   - 与开发机相比，只有连接地址需要改：
#       MySQL 主机由 localhost 改成 sky-mysql、端口由 3307 改成 3306；
#       Redis 主机由 localhost 改成 sky-redis。
# ============================================================================


# ---------------------------------------------------------------------------
# 一、容器自身使用（MySQL / Redis / 时区）
# ---------------------------------------------------------------------------

# MySQL root 口令：MySQL 容器【首次初始化数据目录】时使用。
#   提示：请填写新的强口令，不要沿用开发机的弱口令。
#   注意：该口令只在数据卷首次初始化时生效，之后改这里不会改变库里已存在的口令。
MYSQL_ROOT_PASSWORD=

# 数据库名：填写 sky_take_out（沿用开发机库名）。
MYSQL_DATABASE=

# 应用专用数据库账号名：建议不要用 root，另建一个只对 sky_take_out 库有权限的账号。
MYSQL_USER=

# 应用专用数据库账号口令：必须与下面的 SKY_DATASOURCE_PASSWORD 保持一致。
MYSQL_PASSWORD=

# Redis 访问口令：Redis 容器以 --requirepass 方式启动，缺此项 compose 会直接报错退出。
#   必须与下面的 SKY_REDIS_PASSWORD 保持一致。
REDIS_PASSWORD=

# 时区：填写 Asia/Shanghai（与后端 JDBC 的 serverTimezone 对齐）。
TZ=


# ---------------------------------------------------------------------------
# 二、后端连接配置
#     对应后端 application.yml 里的 ${sky.datasource.*} 与 ${sky.redis.*}。
#     变量名用「下划线大写」，Spring Boot 会自动宽松绑定回配置键，
#     例如 SKY_DATASOURCE_HOST 等价于 sky.datasource.host。
# ---------------------------------------------------------------------------

# 数据库驱动类名：填写 com.mysql.cj.jdbc.Driver
SKY_DATASOURCE_DRIVER_CLASS_NAME=

# 数据库主机：填写 sky-mysql（compose 服务名，容器之间用服务名互访）
SKY_DATASOURCE_HOST=

# 数据库端口：填写 3306（容器内端口，不再是开发机的 3307）
SKY_DATASOURCE_PORT=

# 数据库名：填写 sky_take_out
SKY_DATASOURCE_DATABASE=

# 数据库账号：与上面 MYSQL_USER 保持一致
SKY_DATASOURCE_USERNAME=

# 数据库口令：与上面 MYSQL_PASSWORD 保持一致
SKY_DATASOURCE_PASSWORD=

# Redis 主机：填写 sky-redis（compose 服务名）
SKY_REDIS_HOST=

# Redis 端口：填写 6379
SKY_REDIS_PORT=

# Redis 口令：与上面 REDIS_PASSWORD 保持一致
SKY_REDIS_PASSWORD=

# Redis 库序号：与开发环境相同（0）
SKY_REDIS_DATABASE=


# ---------------------------------------------------------------------------
# 三、后端业务配置
#     对应后端 application.yml 里的 ${sky.*} 占位符。
#     这些键【一个都不能少】（连上面第二节共 24 个 sky.* 键），
#     少一个后端就会启动失败，报 Could not resolve placeholder 'sky.xxx'。
#     取值来自本机的 application-dev.yml；标注「密钥」的项建议换成新值。
# ---------------------------------------------------------------------------

# 管理端 JWT 签名密钥：建议换一个新的随机串（更换后旧的登录令牌会失效）。
SKY_JWT_ADMIN_SECRET_KEY=

# 用户端 JWT 签名密钥：建议换一个新的随机串。
SKY_JWT_USER_SECRET_KEY=

# 微信小程序 AppID：与开发环境相同。
SKY_WECHAT_APPID=

# 微信小程序密钥（密钥）：与开发环境相同。
SKY_WECHAT_SECRET=

# 微信登录接口地址：与开发环境相同。
SKY_WECHAT_URL_LOGIN=

# 阿里云 OSS 访问域名 Endpoint：与开发环境相同。
SKY_ALIOSS_ENDPOINT=

# 阿里云 OSS AccessKeyId（密钥）：与开发环境相同。
SKY_ALIOSS_ACCESS_KEY_ID=

# 阿里云 OSS AccessKeySecret（密钥）：与开发环境相同。
SKY_ALIOSS_ACCESS_KEY_SECRET=

# 阿里云 OSS 存储桶名称：与开发环境相同。
SKY_ALIOSS_BUCKET_NAME=

# 百度地图 AK（密钥）：与开发环境相同。
SKY_BAIDU_MAP_ACCESS_KEY=

# 百度地图地理编码接口地址：与开发环境相同。
SKY_BAIDU_MAP_URL_GEOCODING=

# 百度地图路线规划接口地址：与开发环境相同。
SKY_BAIDU_MAP_URL_DIRECTION=

# 门店地址：与开发环境相同。
SKY_SHOP_ADDRESS=

# 门店配送距离上限（单位：米）：与开发环境相同。
SKY_SHOP_LIMIT_DISTANCE=
